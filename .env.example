# PostgreSQL
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Existing application secrets
ANALYTICS_COOKIE_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Social analytics: generate a random 32-byte value and base64-encode it.
SOCIAL_ANALYTICS_ENCRYPTION_KEY=
SOCIAL_ANALYTICS_CRON_SECRET=

# Meta Facebook Page OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/social-analytics/callback/facebook

# Meta Instagram Business OAuth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/social-analytics/callback/instagram

# TikTok Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/social-analytics/callback/tiktok

# Google / YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/social-analytics/callback/youtube
